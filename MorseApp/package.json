{
  "name": "morse-chat-pro",
  "version": "1.0.0",
  "description": "Morse Chat Pro",
  "author": "Moaaz Beder",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --dir",
    "check": "node --check main.js && node --check JS/login.js && node --check JS/chat-state.js && node --check JS/chat-ui.js && node --check JS/chat-sockets.js && node --check JS/chat-actions.js && node --check JS/chat-render.js && node --check JS/calls.js && node --check JS/splash.js"
  },
  "build": {
    "appId": "com.morsechatpro.app",
    "productName": "Morse Chat Pro",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "Html/**/*",
      "CSS/**/*",
      "JS/**/*",
      "assets/**/*",
      "Audio/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Morse-Chat-Pro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Morse Chat Pro"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "socket.io-client": "^4.8.3"
  }
}
