{
  "name": "morse-chat-pro",
  "version": "1.0.0",
  "description": "Morse Chat Pro",
  "author": "Moaaz Beder",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "configure:dev": "node scripts/write-app-config.js development",
    "configure:prod": "node scripts/write-app-config.js production",
    "start": "npm run configure:dev && electron .",
    "build": "electron-builder --win",
    "build:win:prod": "npm run configure:prod && electron-builder --win",
    "build:dir": "electron-builder --dir",
    "android:prepare": "npm run configure:prod && node scripts/prepare-android.js",
    "android:sync": "npm run android:prepare && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:aab": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "check": "node --check main.js && node --check scripts/write-app-config.js && node --check scripts/prepare-android.js && node --check JS/login.js && node --check JS/chat-state.js && node --check JS/chat-ui.js && node --check JS/chat-sockets.js && node --check JS/chat-actions.js && node --check JS/chat-render.js && node --check JS/calls.js && node --check JS/splash.js"
  },
  "build": {
    "appId": "com.morsechatpro.app",
    "productName": "Morse Chat Pro",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "moaaz-12345",
        "repo": "Morse-Chat-Pro",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "Html/**/*",
      "CSS/**/*",
      "JS/**/*",
      "assets/**/*",
      "Audio/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Morse-Chat-Pro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Morse Chat Pro"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "electron-updater": "^6.8.9",
    "socket.io-client": "^4.8.3"
  }
}
