NODE_ENV=production
PORT=3000

# Frontend origin used by CORS and Google OAuth redirect.
# For Electron-only distribution, keep this as the hosted landing/update page if available.
CLIENT_ORIGIN=https://your-frontend-or-landing-domain.example.com

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/morse_chat_pro?retryWrites=true&w=majority

# Use at least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d

# Google OAuth production credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend-domain.example.com/auth/google/callback
